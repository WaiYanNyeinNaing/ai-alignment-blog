---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function slugFromId(id: string): string {
  return id.replace('.md', '').replace('.mdx', '');
}
---

<BaseLayout title="AI Safety & Alignment">
  <section class="article-list">
    {
      posts.map((post) => {
        const dateStr = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        return (
          <div class="article-entry">
            <span class="date">{dateStr}</span>
            <a href={`/blog/${slugFromId(post.id)}/`} class="title">{post.data.title}</a>
          </div>
        );
      })
    }
  </section>
</BaseLayout>
