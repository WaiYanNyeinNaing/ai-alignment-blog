---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function slugFromId(id: string): string {
  return id.replace('.md', '').replace('.mdx', '');
}
---

<BaseLayout title="AI Safety & Alignment Blog">
  <section class="hero">
    <h1>AI Safety &amp; Alignment</h1>
    <p>Clear explanations of AI alignment, safety research, and responsible AI development — written for builders, researchers, and the curious.</p>
  </section>

  <section class="article-list">
    <h2>Articles</h2>
    {
      posts.length > 0 ? (
        posts.map((post) => (
          <article class="article-card">
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {post.data.category && <span> · {post.data.category}</span>}
            </div>
            <h3><a href={`/blog/${slugFromId(post.id)}/`}>{post.data.title}</a></h3>
            {post.data.description && <p>{post.data.description}</p>}
          </article>
        ))
      ) : (
        <p style="color: var(--text-muted); padding: 2rem 0;">No articles yet. Coming soon.</p>
      )
    }
  </section>
</BaseLayout>
